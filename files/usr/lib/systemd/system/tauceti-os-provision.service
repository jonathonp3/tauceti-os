[Unit]
Description=Tauceti OS: provision on first boot
After=local-fs.target
# Only run once per install
ConditionPathExists=!/etc/tauceti-os/tauceti-os-provisioned

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/bash /usr/libexec/tauceti-os-provision.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
